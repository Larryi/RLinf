# Copy outside the repository, fill it, then chmod 600 private.env.

export HF_TOKEN="<hf-token>"
# This repository must contain the unique 90 successful demonstrations
# (the original 60 plus 30 OOD/DAgger demonstrations).
export SFT_DATASET_REPO="<owner/so101-demo90-dataset>"
# This repository must contain the labeled 50-policy-rollout dataset.
# timeout and failure episodes must both have is_success=false.
export ROLLOUT_DATASET_REPO="<owner/so101-rollout-dataset>"
export OPENPI_CHECKPOINT_REPO="<owner/pi05-so101-rlinf-checkpoint>"
export OUTPUT_MODEL_REPO="<owner/so101-recap-runs>"
export OUTPUT_MODEL_PRIVATE="1"

# Optional: run a suffix of the pipeline on a replacement instance.
# Values: returns,value,advantages,cfg or a comma-separated sequence.
export RECAP_STAGES="returns,value,advantages,cfg"
# Resume trainer state previously uploaded under OUTPUT_MODEL_REPO/RUN_ID.
# export RESUME_RUN_ID="so101_recap_20260805_120000"
# Reuse a locally trained value model (upload it first with upload_assets.sh).
# Then run only the tail of the pipeline on the cloud:
#   export RECAP_STAGES="advantages,cfg"
#   export VALUE_CHECKPOINT_REPO="<owner/value-checkpoint-repo>"
# export VALUE_CHECKPOINT_REPO=""

export GPU_IDS="0"
export GPU_COUNT="1"
export RUN_ID="so101_recap_$(date +%Y%m%d_%H%M%S)"
export PREPARE_ENV="1"
export CHECKPOINT_UPLOAD_INTERVAL="300"
# UPLOAD_CHECKPOINTS=0 (default): 只在阶段完成时上传最终产物到 HF,
# 训练中不再增量上传每个 checkpoint。改 1 恢复旧行为。
export UPLOAD_CHECKPOINTS="0"
# PRUNE_CHECKPOINTS=1 (default): 训练中只保留最新 KEEP_CHECKPOINTS 个
# checkpoint(3.35B CFG checkpoint 约 7G/个),防止磁盘爆满。
export PRUNE_CHECKPOINTS="1"
export KEEP_CHECKPOINTS="1"

# FAST_MODE=1 (default): on 96 GB GPUs drop the 24 GB-era CPU offload and
# activation checkpointing for the CFG stage. Set to 0 for the YAML defaults.
export FAST_MODE="1"
# INSTALL_ENV=dummy (default): RECAP trains offline, so skip libero/maniskill
# assets entirely. Only set maniskill_libero if rollout/RL envs are needed.
export INSTALL_ENV="dummy"

# Single RTX PRO 6000 WS 96GB defaults.
export VALUE_MICRO_BATCH="4"
export VALUE_GLOBAL_BATCH="32"
export VALUE_MAX_STEPS="8000"
export VALUE_SAVE_INTERVAL="500"
export CFG_MICRO_BATCH="1"
export CFG_GLOBAL_BATCH="8"
export CFG_MAX_STEPS="3000"
export CFG_SAVE_INTERVAL="250"
export TRAIN_EXPERT_ONLY="1"

export WANDB_API_KEY="<wandb-key-or-empty>"
export WANDB_PROJECT="rlinf-so101-recap"
export SERVERCHAN_SENDKEY="<serverchan-sendkey-or-empty>"

export VAST_INSTANCE_ID="<instance-id>"
export VAST_API_KEY="<vast-api-key>"
export AUTO_STOP_INSTANCE="1"
export AUTO_STOP_ON_FAILURE="0"
